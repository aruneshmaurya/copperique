    },
    {
      "type": "text",
      "id": "btn_label",
      "default": "SHOP NOW",
      "label": "Primary Button Label"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_label",
      "label": "Secondary Button Label (Optional)"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Social Proof & Trust Stats"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "default": true,
      "label": "Show Trust Stats Overlay"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "default": "4.7 ★",
      "label": "Stat 1 Number / Star Rating"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "default": "From 1,067+ families",
      "label": "Stat 1 Label"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "default": "75+",
      "label": "Stat 2 Number"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "default": "Years of craftsmanship",
      "label": "Stat 2 Label"
    },
    {
      "type": "header",
      "content": "Bottom Feature Marquee Ticker"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_ticker",
      "default": true,
      "label": "Show Bottom Trust Ticker"
    },
    {
      "type": "text",
      "id": "ticker_item_1",
      "default": "Pure 78:22 Kansa",
      "label": "Ticker Item 1"
    },
    {
      "type": "text",
      "id": "ticker_item_2",
      "default": "Hand-Beaten in Sihor",
      "label": "Ticker Item 2"
    },
    {
      "type": "text",
      "id": "ticker_item_3",
      "default": "Lifetime Buy-Back",
      "label": "Ticker Item 3"
    },
    {
      "type": "text",
      "id": "ticker_item_4",
      "default": "COD & Easy Returns",
      "label": "Ticker Item 4"
    },
    {
      "type": "color",
      "id": "ticker_bg",
      "default": "#FAF5EE",
      "label": "Ticker Background Color"
    },
    {
      "type": "color",
      "id": "ticker_text_color",
      "default": "#6B3C23",
      "label": "Ticker Text Color"
    },
    {
      "type": "header",
      "content": "Card Layout & Dimensions"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Card Corner Radius"
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Card Side Inset / Margin"
    },
    {
      "type": "range",
      "id": "top_margin",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6,
      "label": "Top Spacing (Gap below Announcement Bar)"
    },
    {
      "type": "range",
      "id": "bottom_margin",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Bottom Spacing"
