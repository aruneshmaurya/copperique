      "label": "Desktop Video URL (MP4 / WebM)",
      "info": "Paste MP4 link from Shopify Files or external CDN"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Poster / Fallback Image"
    },
    {
      "type": "text",
      "id": "video_url_mobile",
      "label": "Mobile Video URL (Optional 9:16 / 4:5 MP4)",
      "info": "Leave blank to use desktop video on mobile"
    },
    {
      "type": "image_picker",
