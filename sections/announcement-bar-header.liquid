{%- comment -%}
  =============================================================================
  COPPERIQUE / LUXURY BESPOKE ANNOUNCEMENT BAR (HEADER SECTION)
  Inspired directly by Kansawala (https://kansawalas.com/), Aesop & Zara Home
  - Boxed floating container with rounded corners (12px radius)
  - Refined spacing between header and announcement bar
  - Colors: Warm Ivory (#FAF5EE / #F8F4EF), Earthy Muted Bronze (#6B3C23 / #6E5948), Border (#C2AB9D / #D8C8B8)
  - Typography: Instrument Sans / Helvetica Neue / Inter (13px/14px, 500, 0.3px tracking)
  - Circular separator dots (6px) with luxury breathing room
  - Seamless hardware-accelerated infinite marquee with pause on hover
  - Mobile touch-optimized marquee & tablet responsive spacing
  - Keyboard accessible & respects prefers-reduced-motion
  =============================================================================
{%- endcomment -%}

{%- if section.settings.enable -%}
  {%- liquid
    assign bg_color = section.settings.color_bg | default: '#FAF5EE'
    assign text_color = section.settings.color_text | default: '#6B3C23'
    assign text_hover_color = section.settings.color_text_hover | default: '#4A3A2F'
    assign border_color = section.settings.color_border | default: '#C2AB9D'
    assign separator_color = section.settings.color_separator | default: '#6B3C23'
    assign corner_radius = section.settings.border_radius | default: 12
    assign space_top = section.settings.space_top | default: 6
    assign space_bottom = section.settings.space_bottom | default: 6
    assign side_padding = section.settings.side_padding | default: 16
    assign desktop_speed = section.settings.scroll_speed | default: 35
    assign mobile_speed = section.settings.mobile_scroll_speed | default: 22
    assign auto_scroll = section.settings.auto_scroll
    assign mobile_marquee = section.settings.mobile_marquee
    assign pause_on_hover = section.settings.pause_on_hover
  -%}

  <style>
    #shopify-section-{{ section.id }} {
      --luxury-ann-bg: {{ bg_color }};
      --luxury-ann-text: {{ text_color }};
      --luxury-ann-text-hover: {{ text_hover_color }};
      --luxury-ann-border: {{ border_color }};
      --luxury-ann-separator: {{ separator_color }};
      --luxury-ann-radius: {{ corner_radius }}px;
      --luxury-ann-space-top: {{ space_top }}px;
      --luxury-ann-space-bottom: {{ space_bottom }}px;
      --luxury-ann-side-padding: {{ side_padding }}px;
      --luxury-ann-desktop-speed: {{ desktop_speed }}s;
      --luxury-ann-mobile-speed: {{ mobile_speed }}s;
      width: 100%;
      position: relative;
      z-index: 100;
      padding-top: var(--luxury-ann-space-top);
      padding-bottom: var(--luxury-ann-space-bottom);
      box-sizing: border-box;
    }

    .luxury-announcement-container {
      width: 100%;
      padding-left: var(--luxury-ann-side-padding);
      padding-right: var(--luxury-ann-side-padding);
      box-sizing: border-box;
      margin: 0 auto;
    }

    .luxury-announcement-bar {
      display: flex;
      align-items: center;
      width: 100%;
      min-height: 40px;
      height: 40px;
      background-color: var(--luxury-ann-bg);
      border: 1px solid var(--luxury-ann-border);
      border-radius: var(--luxury-ann-radius);
      color: var(--luxury-ann-text);
      font-family: "Instrument Sans", "Helvetica Neue", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 13px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.3px;
      overflow: hidden;
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .luxury-announcement-bar__viewport {
      display: flex;
      align-items: center;
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
    }

    .luxury-announcement-bar--static .luxury-announcement-bar__viewport {
      justify-content: center;
    }

    .luxury-announcement-bar--static .luxury-announcement-bar__static-group {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      padding: 0 20px;
    }

    .luxury-announcement-bar__track {
      display: inline-flex;
      align-items: center;
      white-space: nowrap;
      flex-shrink: 0;
      will-change: transform;
      transform: translate3d(0, 0, 0);
    }

    .luxury-announcement-bar--autoscroll .luxury-announcement-bar__track {
      animation: luxuryAnnouncementScroll var(--luxury-ann-desktop-speed) linear infinite;
    }

    @keyframes luxuryAnnouncementScroll {
      0% {
        transform: translate3d(0, 0, 0);
      }
      100% {
        transform: translate3d(-50%, 0, 0);
      }
    }

    {%- if pause_on_hover -%}
      .luxury-announcement-bar--pause-hover:hover .luxury-announcement-bar__track {
        animation-play-state: paused !important;
      }
    {%- endif -%}

    .luxury-announcement-bar__item {
      display: inline-flex;
      align-items: center;
      color: var(--luxury-ann-text);
      text-decoration: none;
      transition: color 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .luxury-announcement-bar__item:visited {
      color: var(--luxury-ann-text);
    }

    .luxury-announcement-bar__item:hover,
    .luxury-announcement-bar__item:focus-visible {
      color: var(--luxury-ann-text-hover);
      text-decoration: none;
    }

    .luxury-announcement-bar__item:focus-visible {
      outline: 1px solid var(--luxury-ann-text-hover);
      outline-offset: 3px;
      border-radius: 2px;
    }

    .luxury-announcement-bar__dot {
      display: inline-block;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background-color: var(--luxury-ann-separator);
      margin: 0 36px;
      flex-shrink: 0;
      vertical-align: middle;
      pointer-events: none;
    }

    @media (max-width: 1024px) {
      .luxury-announcement-container {
        padding-left: 12px;
        padding-right: 12px;
      }

      .luxury-announcement-bar__dot {
        margin: 0 24px;
      }
    }

    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        padding-top: 4px;
        padding-bottom: 4px;
      }

      .luxury-announcement-container {
        padding-left: 8px;
        padding-right: 8px;
      }

      .luxury-announcement-bar {
        height: 36px;
        min-height: 36px;
        border-radius: 10px;
        font-size: 12px;
      }

      .luxury-announcement-bar__dot {
        width: 4px;
        height: 4px;
        margin: 0 16px;
      }

      {%- if mobile_marquee -%}
        .luxury-announcement-bar__static-group {
          display: none !important;
        }

        .luxury-announcement-bar__track {
          display: inline-flex !important;
          animation: luxuryAnnouncementScroll var(--luxury-ann-mobile-speed) linear infinite !important;
        }
      {%- else -%}
        .luxury-announcement-bar__track {
          animation: none !important;
        }
      {%- endif -%}
    }

    @media (prefers-reduced-motion: reduce) {
      .luxury-announcement-bar__track {
        animation: none !important;
        transform: none !important;
      }
      .luxury-announcement-bar__viewport {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
    }
  </style>

  {%- capture announcement_block -%}
    {%- if section.settings.text_1 != blank -%}
      {%- if section.settings.link_1 != blank -%}
        <a href="{{ section.settings.link_1 }}" class="luxury-announcement-bar__item">
          {{ section.settings.text_1 | escape }}
        </a>
      {%- else -%}
        <span class="luxury-announcement-bar__item">
          {{ section.settings.text_1 | escape }}
        </span>
      {%- endif -%}
      <span class="luxury-announcement-bar__dot" aria-hidden="true"></span>
    {%- endif -%}

    {%- if section.settings.text_2 != blank -%}
      {%- if section.settings.link_2 != blank -%}
        <a href="{{ section.settings.link_2 }}" class="luxury-announcement-bar__item">
          {{ section.settings.text_2 | escape }}
        </a>
      {%- else -%}
        <span class="luxury-announcement-bar__item">
          {{ section.settings.text_2 | escape }}
        </span>
      {%- endif -%}
      <span class="luxury-announcement-bar__dot" aria-hidden="true"></span>
    {%- endif -%}

    {%- if section.settings.text_3 != blank -%}
      {%- if section.settings.link_3 != blank -%}
        <a href="{{ section.settings.link_3 }}" class="luxury-announcement-bar__item">
          {{ section.settings.text_3 | escape }}
        </a>
      {%- else -%}
        <span class="luxury-announcement-bar__item">
          {{ section.settings.text_3 | escape }}
        </span>
      {%- endif -%}
      <span class="luxury-announcement-bar__dot" aria-hidden="true"></span>
    {%- endif -%}
  {%- endcapture -%}

  <div class="luxury-announcement-container">
    <aside
      id="luxury-announcement-bar-{{ section.id }}"
      class="luxury-announcement-bar{% if auto_scroll %} luxury-announcement-bar--autoscroll{% else %} luxury-announcement-bar--static{% endif %}{% if pause_on_hover %} luxury-announcement-bar--pause-hover{% endif %}"
      role="region"
      aria-label="{{ 'general.accessibility.announcement' | t | default: 'Announcements' }}"
    >
      <div class="luxury-announcement-bar__viewport">
        {%- if auto_scroll or mobile_marquee -%}
          <div class="luxury-announcement-bar__track" aria-live="off">
            <div class="luxury-announcement-bar__half">
              {{ announcement_block }}
              {{ announcement_block }}
            </div>
            <div class="luxury-announcement-bar__half" aria-hidden="true">
              {{ announcement_block }}
              {{ announcement_block }}
            </div>
          </div>
        {%- endif -%}

        {%- unless auto_scroll -%}
          <div class="luxury-announcement-bar__static-group">
            {{ announcement_block }}
          </div>
        {%- endunless -%}
      </div>
    </aside>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Luxury Announcement Bar",
  "tag": "section",
  "class": "luxury-announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "checkbox",
      "id": "enable",
      "default": true,
      "label": "Enable Announcement Bar"
    },
    {
      "type": "header",
      "content": "Boxed Layout & Spacing (Kansawala Style)"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "Corner Radius (Rounded Corners)"
    },
    {
      "type": "range",
      "id": "space_top",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6,
      "label": "Top Spacing"
    },
    {
      "type": "range",
      "id": "space_bottom",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 6,
      "label": "Bottom Spacing (Space between Header)"
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "Side Inset / Margin"
    },
    {
      "type": "header",
      "content": "Aesthetic Colors"
    },
    {
      "type": "color",
      "id": "color_bg",
      "default": "#FAF5EE",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "color_text",
      "default": "#6B3C23",
      "label": "Text Color"
    },
    {
      "type": "color",
      "id": "color_text_hover",
      "default": "#4A3A2F",
      "label": "Text Hover Color"
    },
    {
      "type": "color",
      "id": "color_border",
      "default": "#C2AB9D",
      "label": "Border Color"
    },
    {
      "type": "color",
      "id": "color_separator",
      "default": "#6B3C23",
      "label": "Separator Dot Color"
    },
    {
      "type": "header",
      "content": "Announcement Content"
    },
    {
      "type": "text",
      "id": "text_1",
      "default": "Pay a little now, the rest on delivery – settle the balance when it reaches your hands",
      "label": "Announcement Text 1"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Announcement Link 1 (Optional)"
    },
    {
      "type": "text",
      "id": "text_2",
      "default": "The more you bring home, the more we add back – save 5% to 15% at checkout",
      "label": "Announcement Text 2"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Announcement Link 2 (Optional)"
    },
    {
      "type": "text",
      "id": "text_3",
      "default": "Free shipping across India on eligible orders",
      "label": "Announcement Text 3"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Announcement Link 3 (Optional)"
    },
    {
      "type": "header",
      "content": "Desktop Animation"
    },
    {
      "type": "checkbox",
      "id": "auto_scroll",
      "default": true,
      "label": "Enable Auto Scroll"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 35,
      "label": "Desktop Scroll Speed"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "default": true,
      "label": "Pause on Hover"
    },
    {
      "type": "header",
      "content": "Mobile Animation"
    },
    {
      "type": "checkbox",
      "id": "mobile_marquee",
      "default": true,
      "label": "Enable Mobile Marquee"
    },
    {
      "type": "range",
      "id": "mobile_scroll_speed",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "s",
      "default": 22,
      "label": "Mobile Scroll Speed"
    }
  ],
  "presets": [
    {
      "name": "Luxury Announcement Bar",
      "category": "Header"
    }
  ]
}
{% endschema %}