{{ 'copperique-hero.css' | asset_url | stylesheet_tag }}

<div class="copperique-hero {% if section.settings.enable_animations %}hero-animated{% endif %}" 
     data-section-id="{{ section.id }}" 
     data-section-type="copperique-hero">
    
    <div class="hero-bg-layer">
        <div class="radial-glow"></div>
        <div class="noise-texture"></div>
    </div>

    <div class="hero-container">
        <div class="hero-top-content">
            {% if section.settings.badge_text != blank %}
                <div class="hero-trust-badge">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="badge-icon"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    <span>{{ section.settings.badge_text | escape }}</span>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="badge-icon"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
            {% endif %}
            
            {% if section.settings.heading != blank %}
                <h1 class="hero-heading">{{ section.settings.heading | newline_to_br }}</h1>
            {% endif %}
            
            {% if section.settings.description != blank %}
                <div class="hero-description">{{ section.settings.description }}</div>
            {% endif %}

            {% if section.settings.btn_primary_text != blank %}
                <div class="hero-cta-wrapper">
                    <a href="{{ section.settings.btn_primary_link }}" class="btn-primary" aria-label="{{ section.settings.btn_primary_text | escape }}">
                        {{ section.settings.btn_primary_text | escape }} &rarr;
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="hero-bottom-visuals">
            <div class="copper-semi-circle"></div>
            
            <div class="floating-products-container">
                <div class="main-product-wrapper">
                    {% if section.settings.hero_image != blank %}
                        <img src="{{ section.settings.hero_image | img_url: '1000x' }}" 
                             alt="{{ section.settings.hero_image.alt | default: section.settings.heading | escape }}"
                             class="main-bottle parallax-layer" 
                             data-parallax-speed="0.03"
                             loading="lazy">
                    {% else %}
                         {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg main-bottle parallax-layer' }}
                    {% endif %}
                </div>

                {% if section.settings.glass_image != blank %}
                    <img src="{{ section.settings.glass_image | img_url: '400x' }}" 
                         alt="Copper Glass" 
                         class="floating-glass parallax-layer" 
                         data-parallax-speed="0.08"
                         loading="lazy">
                {% endif %}

                {% if section.settings.jug_image != blank %}
                    <img src="{{ section.settings.jug_image | img_url: '400x' }}" 
                         alt="Copper Jug" 
                         class="floating-jug parallax-layer" 
                         data-parallax-speed="-0.04"
                         loading="lazy">
                {% endif %}
                
                <div class="particles-container">
                    <div class="particle p1 parallax-layer" data-parallax-speed="0.1"></div>
                    <div class="particle p2 parallax-layer" data-parallax-speed="0.15"></div>
                    <div class="particle p3 parallax-layer" data-parallax-speed="-0.05"></div>
                    <div class="particle p4 parallax-layer" data-parallax-speed="0.08"></div>
                    <div class="particle p5 parallax-layer" data-parallax-speed="-0.1"></div>
                    <div class="droplet d1 parallax-layer" data-parallax-speed="0.12"></div>
                    <div class="droplet d2 parallax-layer" data-parallax-speed="-0.08"></div>
                </div>
            </div>
        </div>
    </div>
</div>

{% if section.settings.enable_animations %}
<script src="{{ 'copperique-hero.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "Copperique Hero",
  "class": "index-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_animations",
      "label": "Enable Parallax & Hover Animations",
      "default": true
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Top Badge Text",
      "default": "Trusted by over 50,000+ customers"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Pure Copper.\nTimeless Wellness."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Experience timeless wellness through handcrafted copper drinkware inspired by Ayurveda and designed for modern lifestyles.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_primary_text",
      "label": "Primary Button Text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "btn_primary_link",
      "label": "Primary Button Link"
    },
    {
      "type": "header",
      "content": "Imagery"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Main Floating Bottle Image"
    },
    {
      "type": "image_picker",
      "id": "glass_image",
      "label": "Floating Glass Image (Optional)"
    },
    {
      "type": "image_picker",
      "id": "jug_image",
      "label": "Floating Jug Image (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Copperique Hero",
      "category": "Image"
    }
  ]
}
{% endschema %}
